// inspired by https://github.com/mylinuxforwork/dotfiles
{
  "layer": "top",
  "position": "top",
  "margin-top": 1,
  "margin-bottom": 0,
  "margin-left": 2,
  "margin-right": 2,
  "height": 20,

  "include": ["~/.config/waybar/module-config.json"],

  "modules-left": [
    "hyprland/workspaces",
    "cpu",
    "temperature",
    "memory",
    "disk",
    "temperature#ssd",
    "custom/gpu-usage",
    "temperature#gpu",
    "custom/updates",
    "mpris"
  ],

  "modules-center": ["hyprland/window"],

  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "backlight",
    "power-profiles-daemon",
    "idle_inhibitor",
    "pulseaudio",
    "battery",
    "custom/notification",
    "clock"
  ]
}

